{
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "doctrine/orm": "^3.3",
    "doctrine/doctrine-bundle": "^2.13",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "symfony/yaml": "7.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "extra": {
    "runtime": {
      "dotenv_path": ".env"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.3.0"
    }
  }
}