{% extends 'base.html.twig' %}
{% block title %}{{ product.setName }} · {{ product.language }} · TCG Radar{% endblock %}
{% block body %}
<a class="back" href="/">← Retour au catalogue</a>
<div class="eyebrow">{{ product.game }} / {{ product.language }} / {{ product.setCode }}</div>
<h1>{{ product.setName }}</h1>
<p class="muted">{{ product.canonical ? 'Référence du catalogue' : 'Référence marchande · correspondance à vérifier' }}{% if product.catalogSource %} · <a href="{{ product.catalogSource }}" target="_blank" rel="noopener">Source du catalogue ↗</a>{% endif %}</p>
<div class="detail-grid"><section class="panel" id="history" data-product="{{ product.id }}"><div class="section-head"><h2>Évolution du prix</h2><div class="periods" aria-label="Période">{% for days in [7,30,90] %}<button type="button" data-days="{{ days }}" aria-pressed="{{ days == 30 ? 'true' : 'false' }}">{{ days }} j</button>{% endfor %}</div></div><p class="muted">Minimum observé par jour et par display. Aucun prix n’est inventé entre les collectes.</p><div id="chart" aria-live="polite"></div><div class="legend"><span>● Port connu</span><span>● Port inconnu · estimation hors port</span></div><details><summary>Consulter les valeurs du graphique</summary><div id="chart-values"></div></details></section>
<aside class="panel"><div class="eyebrow">SURVEILLANCE</div><h2>Votre prix cible</h2><p class="muted">Alerte dans cette application lorsque le prix par display atteint votre seuil. Enregistrée dans ce navigateur et vérifiée tant que la page reste ouverte.</p><form id="watch-form" data-product="{{ product.id }}"><label for="target">Prix maximum par display (€)</label><input id="target" type="number" step="0.01" min="0.01" required><button class="primary" type="submit">Surveiller ce set</button><button type="button" id="remove-watch">Supprimer</button></form><p id="watch-status" role="status"></p></aside></div>
<div class="section-head"><h2>Toutes les offres <small>{{ offers|length }}</small></h2><span class="muted">Case complète à acheter · prix unitaire indicatif</span></div>
<p class="muted">Origine et frais pour une livraison en France métropolitaine. Les anciennes offres sans source restent à confirmer. <a href="https://www.douane.gouv.fr/demarche/vous-achetez-sur-internet" target="_blank" rel="noopener noreferrer">Règles de la douane ↗</a></p><div class="table-wrap"><table><thead><tr><th>Boutique / produit</th><th>Conditionnement</th><th>Prix boutique</th><th>Port France</th><th>Total estimé</th><th>Par display</th><th>Disponibilité</th><th></th></tr></thead><tbody>
{% for o in offers %}<tr><td><strong>{{ o.store.name }}</strong><small>{{ o.title }}</small>{% include "_shipping_origin.html.twig" %}<small>Vérifié le {{ o.checkedAt|date('d/m/Y H:i', 'Europe/Paris') }}</small></td><td>{{ o.displayCount ? o.displayCount~' display'~(o.displayCount > 1 ? 's' : '') : 'Case · quantité inconnue' }}</td><td>{{ o.price|number_format(2, ',', ' ') }} {{ o.currency }}</td><td>{{ o.shippingKnown ? o.shipping|number_format(2, ',', ' ')~' €' : 'Inconnu' }}</td><td>{{ o.landedCost|number_format(2, ',', ' ') }} €{% include "_import_cost_note.html.twig" %}{% if not o.shippingKnown %}<small>hors port</small>{% endif %}</td><td class="unit">{{ o.unitCost is not null ? o.unitCost|number_format(2, ',', ' ')~' €' : 'Non comparable' }}</td><td>{{ o.checkedAt < date('-48 hours') ? 'À revérifier' : (o.inStock ? 'En stock' : 'Indisponible / à confirmer') }}</td><td><a class="button" href="{{ o.url }}" target="_blank" rel="noopener noreferrer">Voir ↗</a></td></tr>
{% else %}<tr><td colspan="8" class="empty">Aucune offre collectée pour ce set.</td></tr>{% endfor %}
</tbody></table></div>
<section class="panel discovery" aria-labelledby="discovery-title">
<div class="eyebrow">ÉLARGIR LA RECHERCHE</div>
<h2 id="discovery-title">Trouver d’autres boutiques</h2>
<p class="muted">Explorez d’autres boutiques avec les prix relevés sur leurs fiches. Les offres comparables sont triées par prix croissant par display, hors livraison et frais d’import. Les résultats incomplets restent en fin de liste ; vérifiez le montant final chez le marchand.</p>
<form id="discovery-form" data-product="{{ product.id }}"><label for="discovery-keywords">Mots-clés supplémentaires (facultatif)</label><div class="discovery-controls"><input id="discovery-keywords" maxlength="80" placeholder="Ex. livraison France, scellé, case…"><button class="primary" type="submit">Chercher de nouvelles boutiques</button></div></form>
{% include '_discovery_results.html.twig' %}
<details open><summary>Ouvrir la recherche dans un moteur</summary>
{% set langTerms = product.language == 'JP' ? ['booster box Japanese buy','display japonais acheter','BOX 日本語 通販'] : (product.language == 'FR' ? ['display français acheter','boîte de boosters FR','case carton displays français'] : ['booster box English buy','sealed display English','case booster boxes']) %}
{% set code = product.setCode starts with 'UNMATCHED-' or product.setCode starts with 'YGO-' or product.setCode == 'UNKNOWN' ? product.setName : product.setCode %}
<ul class="search-links">{% for terms in langTerms %}{% set query = product.game~' '~(loop.index == 2 ? code : product.setName)~' '~terms %}<li><span>{{ query }}</span><a href="https://www.google.com/search?q={{ query|url_encode }}" target="_blank" rel="noopener noreferrer">Google ↗</a><a href="https://duckduckgo.com/?q={{ query|url_encode }}" target="_blank" rel="noopener noreferrer">DuckDuckGo ↗</a></li>{% endfor %}</ul></details>
</section>
{% endblock %}
